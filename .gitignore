# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Backend — separate git repo, not tracked here
/backend/
backend/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local development artifacts
.claude/settings.local.json
.claude/launch.json
.tmp/
supabase/.temp/

# RASQ ML bridge — local-only research capture data, never committed
# (dev volunteers' movement data; see app/lib/ml-research/shoulder-abduction-reach/README.md)
/dev-data/
